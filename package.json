{
  "name": "obsidian-any-viewer",
  "version": "0.1.0",
  "description": "Insert and preview any file type (Word/Excel/PowerPoint/HTML/CSV and more) inside Obsidian notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "office",
    "docx",
    "xlsx",
    "pptx",
    "html",
    "embed",
    "preview"
  ],
  "author": "tingke",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.3",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "pptx-preview": "^1.0.7",
    "xlsx": "^0.18.5"
  }
}
